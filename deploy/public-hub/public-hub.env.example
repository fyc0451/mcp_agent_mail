APP_ENVIRONMENT=production

# The application must stay behind the local HTTPS reverse proxy.
HTTP_PUBLIC_MODE=true
HTTP_HOST=127.0.0.1
HTTP_PORT=8765
HTTP_PATH=/api/
HTTP_BEARER_TOKEN=
HTTP_ALLOW_LOCALHOST_UNAUTHENTICATED=false

HTTP_JWT_ENABLED=true
HTTP_JWT_ALGORITHMS=RS256
HTTP_JWT_JWKS_URL=https://team-auth.example.com/.well-known/jwks.json
HTTP_JWT_ISSUER=https://team-auth.example.com
HTTP_JWT_AUDIENCE=mcp-agent-mail-human
HTTP_JWT_INTROSPECTION_URL=https://team-auth.example.com/introspect

HTTP_RBAC_ENABLED=true
HTTP_RBAC_DEFAULT_ROLE=reader
HTTP_RBAC_READER_ROLES=reader,read,ro
HTTP_RBAC_WRITER_ROLES=writer,admin

HTTP_RATE_LIMIT_ENABLED=true
HTTP_RATE_LIMIT_BACKEND=redis
HTTP_RATE_LIMIT_REDIS_URL=redis://127.0.0.1:6379/2
HTTP_RATE_LIMIT_PER_MINUTE=60
HTTP_RATE_LIMIT_TOOLS_PER_MINUTE=60
HTTP_RATE_LIMIT_RESOURCES_PER_MINUTE=120

# Browsers talk to their local Cockpit, not directly to the Team Hub.
HTTP_CORS_ENABLED=false
HTTP_REQUEST_LOG_ENABLED=true
LOG_JSON_ENABLED=true

DATABASE_URL=sqlite+aiosqlite:////var/lib/mcp-agent-mail/storage.sqlite3
STORAGE_ROOT=/var/lib/mcp-agent-mail/mailbox
